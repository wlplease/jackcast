# Required for the Farcaster API connection
NEYNAR_API_KEY=
APP_PASSWORD=

# Add after connecting the app at /setup
SIGNER_UUID=
MY_FID=

# Optional: enables the user-triggered AI catch-up digest in Following
GOOGLE_AI_API_KEY=

# Optional: server-side Grok profile image generation. XAI_API_KEY is preferred;
# REACT_APP_GROK_API_KEY is accepted for compatibility and is never sent to the browser.
XAI_API_KEY=
REACT_APP_GROK_API_KEY=
# Optional: set to "private" only when the connected Vercel Blob store is private; defaults to public.
GROK_REQUEST_BLOB_ACCESS=public

# Optional: enables read-aloud for a generated Gemini digest
# Set both values. Choose a voice available to this ElevenLabs API key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: Firebase web app config for the shared Jumping Jacks weekly leaderboard.
# Enable Anonymous sign-in in Firebase Authentication and add the isolated leaderboard rules from docs/ARCADE-FIRESTORE.md.
NEXT_PUBLIC_FIREBASE_CONFIG=
# Alternatively provide the four public web config fields separately:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Legacy typo alias accepted by the speech route; prefer ELEVENLABS_API_KEY.
# ELEVELN_LAB_API_KEY=

# Optional deployment settings
BLOB_READ_WRITE_TOKEN=
# New Vercel Blob stores may use this presigned upload mode instead.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Optional: enables built-in GIPHY search. Server-only; never add NEXT_PUBLIC_ to this key.
GIPHY_APP=
MIN_USER_SCORE=0
PINNED_CHANNELS=
