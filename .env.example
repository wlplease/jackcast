# Required for the Farcaster API connection
NEYNAR_API_KEY=
APP_PASSWORD=

# Add after connecting the app at /setup
SIGNER_UUID=
MY_FID=

# Optional: enables AI catch-up and paid Google profile image/animation features.
# The profile studio also requires Vercel Blob storage.
GOOGLE_AI_API_KEY=

# Optional: set to "private" only when the connected Vercel Blob store is private; defaults to public.
PROFILE_REQUEST_BLOB_ACCESS=public

# Optional: enables read-aloud for a generated Gemini digest
# Set both values. Choose a voice available to this ElevenLabs API key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: Firebase Web App config for the arcade leaderboard and community map.
# Enable Anonymous sign-in and merge only Jackcaster's collection rules from docs/FIREBASE-SHARED-RULES.md.
# Public web config only; no Firebase Admin SDK or service-account key is used.
NEXT_PUBLIC_FIREBASE_CONFIG=
# Alternatively provide the four public web config fields separately:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Legacy typo alias accepted by the speech route; prefer ELEVENLABS_API_KEY.
# ELEVELN_LAB_API_KEY=

# Optional deployment settings
BLOB_READ_WRITE_TOKEN=
# New Vercel Blob stores may use this presigned upload mode instead.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Optional: enables free shared GIPHY search. Server-only; never add NEXT_PUBLIC_ to this key.
GIPHY_APP=
# Upstash Redis REST credentials for an atomic global GIPHY cooldown; no Firebase sign-in/rules needed.
# Existing Vercel KV projects may use KV_REST_API_URL and KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional dedicated cookie-signing secret. Defaults to APP_PASSWORD when unset.
GIPHY_RATE_LIMIT_SECRET=
MIN_USER_SCORE=0
PINNED_CHANNELS=
