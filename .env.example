# Required for the Farcaster API connection
NEYNAR_API_KEY=
APP_PASSWORD=

# Add after connecting the app at /setup
SIGNER_UUID=
MY_FID=

# Optional: enables the user-triggered AI catch-up digest in Following
GOOGLE_AI_API_KEY=

# Optional: enables read-aloud for a generated Gemini digest
# Set both values. Choose a voice available to this ElevenLabs API key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional deployment settings
BLOB_READ_WRITE_TOKEN=
MIN_USER_SCORE=0
PINNED_CHANNELS=
